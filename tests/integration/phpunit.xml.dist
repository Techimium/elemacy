<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="bootstrap.php"
         colors="true"
         cacheResult="false"
         failOnWarning="true"
         failOnRisky="true"
         convertDeprecationsToExceptions="false">
    <testsuites>
        <testsuite name="Real WordPress and Elementor">
            <file>environment-guards.php</file>
            <file>document-lifecycle.php</file>
            <file>fixture-catalog.php</file>
            <file>public-loop.php</file>
            <file>public-loop-pagination.php</file>
            <file>loop-grid-ajax-payload.php</file>
            <file>loop-initial-page-eligibility.php</file>
            <file>current-query-archives.php</file>
            <file>loop-load-more.php</file>
            <file>search-template-conditions.php</file>
            <file>archive-conditions.php</file>
            <file>condition-search.php</file>
            <file>query-pickers.php</file>
            <file>archive-title-preview.php</file>
            <file>nav-menu.php</file>
            <file>loop-ineligibility-notice.php</file>
            <file>loop-pagination-phase1-closeout.php</file>
            <file>loop-context.php</file>
            <file>loop-renderer.php</file>
            <file>loop-base-css-file-fallback.php</file>
            <file>public-loop-request.php</file>
            <file>published-loop-definition.php</file>
            <file>public-render-policy.php</file>
            <file>pagination-context-signer.php</file>
            <file>placement-resolvers.php</file>
            <file>acf-repeater-public-policy.php</file>
            <file>acf-repeater-query-pagination.php</file>
            <file>template-precedence.php</file>
            <file>theme-lifecycle.php</file>
            <file>native-chrome-replacement.php</file>
            <file>real-theme-chrome.php</file>
            <file>location-layouts.php</file>
            <file>elementor-pro-coexistence.php</file>
            <file>theme-hook-cleaner.php</file>
            <file>chrome-documents.php</file>
            <file>atomic-rendering.php</file>
            <file>pro-entitlement.php</file>
            <file>foreign-document-assets.php</file>
            <file>popup-required-capability-suspension.php</file>
            <file>popup-rule-trigger-params-guard.php</file>
            <file>popup-display-defaults.php</file>
            <file>cache-lifecycle.php</file>
            <file>availability-repair-round-trip.php</file>
            <file>condition-registry-extension.php</file>
            <file>library-persistence.php</file>
            <file>module-seeding.php</file>
            <file>template-rendering-preparation.php</file>
            <file>request-state.php</file>
            <file>shared-preparation-across-placements.php</file>
            <file>elementor-compatibility.php</file>
            <file>same-document-content-renderer.php</file>
            <file>transport-policy.php</file>
            <file>form-submissions.php</file>
            <file>analytics-counters.php</file>
            <file>analytics-tracking.php</file>
            <file>migration-leases.php</file>
            <file>dynamic-tags-registration.php</file>
            <file>post-excerpt-tag.php</file>
        </testsuite>
    </testsuites>
</phpunit>
