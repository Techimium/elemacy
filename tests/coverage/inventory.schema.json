{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elemacy coverage inventory",
  "type": "object",
  "required": ["version", "owner", "features", "runners"],
  "properties": {
    "version": {"const": 1},
    "owner": {"enum": ["elemacy", "elemacy-pro"]},
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "kind", "identifier", "source", "implementation", "prerequisites", "journey", "coverage"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner": {"enum": ["elemacy", "elemacy-pro"]},
          "kind": {"enum": ["module", "template", "widget", "tag", "condition", "popup-type", "trigger", "rule", "form-field", "form-action", "loop-source"]},
          "identifier": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "implementation": {"enum": ["real", "placeholder"]},
          "prerequisites": {"type": "array", "items": {"type": "string"}},
          "coverage": {"type": "array", "items": {"type": "string"}},
          "journey": {
            "type": "object",
            "required": ["id", "status", "profiles", "expected", "reason", "follow_up"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"enum": ["pending", "implemented", "blocked"]},
              "profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "expected": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "reason": {"type": "string"},
              "follow_up": {"type": "string"}
            }
          }
        }
      }
    },
    "runners": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "layer", "path"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "layer": {"enum": ["logic", "architecture", "static-browser", "native-browser", "native-integration", "release", "performance"]},
          "path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
