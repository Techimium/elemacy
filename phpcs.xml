<?xml version="1.0"?>

<ruleset name="Strict WordPress Plugin Ruleset (PHP 7+)">
    <description>
        Enforces only the WordPress Coding Standards, Security, and I18n rules
        required for submitting plugins to WordPress.org, assuming minimum PHP 7.x.
        Silences external standards.
    </description>

<!-- Scan only PHP files -->
<file>.</file>
<arg name="extensions" value="php"/>

<!-- Exclude common ignored folders -->
<exclude-pattern>*/vendor/*</exclude-pattern>
<exclude-pattern>*/node_modules/*</exclude-pattern>
<exclude-pattern>*/assets/*</exclude-pattern>
<exclude-pattern>*/build/*</exclude-pattern>
<exclude-pattern>*/tests/*</exclude-pattern>

<!-- WordPress Core Coding Standards -->
<rule ref="WordPress-Core"/>
<rule ref="WordPress-Docs"/>
<rule ref="WordPress-Extra"/>

<!-- Enforce proper i18n with the plugin's text domain -->
<rule ref="WordPress.WP.I18n">
    <properties>
        <property name="text_domain" type="array">
            <element value="elemacy"/>
        </property>
    </properties>
</rule>

<!-- Security: escaping, sanitization, discouraged functions -->
<rule ref="WordPress.Security.EscapeOutput"/>
<rule ref="WordPress.Security.ValidatedSanitizedInput"/>
<rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>

<!-- Disable rules not required for WP plugin review -->
<rule ref="WordPress.Files.FileName">
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
</rule>
<rule ref="Generic.Arrays"><severity>0</severity></rule>
<rule ref="NormalizedArrays.Arrays"><severity>0</severity></rule>
<rule ref="WordPress.WhiteSpace"><severity>0</severity></rule>
<rule ref="PEAR.Functions.FunctionCallSignature"><severity>0</severity></rule>
<rule ref="WordPress.PHP.DiscouragedPHPFunctions"><severity>0</severity></rule>
<rule ref="WordPress.PHP.YodaConditions"><severity>0</severity></rule>
<rule ref="Universal.Arrays.DisallowShortArraySyntax"><severity>0</severity></rule>
<rule ref="WordPress.Arrays.MultipleStatementAlignment"><severity>0</severity></rule>
<rule ref="WordPress.Arrays.ArrayKeySpacingRestrictions"><severity>0</severity></rule>
<rule ref="Generic.NamingConventions.UpperCaseConstantName.ClassConstantNotUpperCase"><severity>0</severity></rule>
<rule ref="Generic.WhiteSpace.ArbitraryParenthesesSpacing"><severity>0</severity></rule>

<!-- Silence all non-WordPress standards -->
<rule ref="PEAR"><severity>0</severity></rule>
<rule ref="Squiz"><severity>0</severity></rule>
<rule ref="Generic"><severity>0</severity></rule>
<rule ref="PSR1"><severity>0</severity></rule>
<rule ref="PSR2"><severity>0</severity></rule>
<rule ref="PSR12"><severity>0</severity></rule>

<!-- CLI args -->
<arg name="colors"/>

</ruleset>
